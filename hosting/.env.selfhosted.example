# Self-hosted Saleor env template. Copy to hosting/.env.selfhosted (git-ignored)
# and paste values into HF Space secrets + keep a local copy for mirror scripts.

# Generate: python3 -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change-me-64-hex-chars

# Neon pooled connection string. Must include sslmode=require.
# Format: postgres://<user>:<pass>@<pooler-host>/<db>?sslmode=require
DATABASE_URL=postgres://user:pass@pooler-host/db?sslmode=require

# Upstash Redis (TLS). Format: rediss://default:<token>@<host>:6379
REDIS_URL=rediss://default:token@host:6379

# Public hostname(s) of the API Space, comma-separated, no scheme.
ALLOWED_HOSTS=shopdeno-saleor-api.hf.space

# Storefront origins allowed to call the API (CORS).
ALLOWED_CLIENT_HOSTS=shop.dennis-muraguri.co.ke,my-catalyst-next.vercel.app

DEFAULT_CHANNEL_SLUG=default-channel

# --- Media: Supabase Storage via S3-compat (django-storages) ---
# Verify exact variable names against docs.saleor.io "Configuration" for 3.23
# before first deploy; Saleor reads AWS_* env for its S3 backend.
AWS_ACCESS_KEY_ID=supabase-s3-access-key
AWS_SECRET_ACCESS_KEY=supabase-s3-secret-key
AWS_MEDIA_BUCKET_NAME=saleor-media
AWS_S3_ENDPOINT_URL=https://<project-ref>.supabase.co/storage/v1/s3
AWS_S3_REGION_NAME=eu-west-1
AWS_S3_CUSTOM_DOMAIN=<project-ref>.supabase.co/storage/v1/object/public/saleor-media

# --- Email (Brevo SMTP) ---
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp-relay.brevo.com
EMAIL_PORT=587
EMAIL_HOST_USER=brevo-login-email
EMAIL_HOST_PASSWORD=brevo-smtp-key
DEFAULT_FROM_EMAIL=sales@shop.dennis-muraguri.co.ke
