# Saleor Storefront Configuration
# Copy this file to .env and fill in your values

# Your Saleor GraphQL API endpoint (required)
# For Saleor Cloud: https://your-store-name.saleor.cloud/graphql/
NEXT_PUBLIC_SALEOR_API_URL=https://your-store.saleor.cloud/graphql/

# Saleor Admin Dashboard URL (optional - auto-generated from API URL if not set)
# NEXT_PUBLIC_SALEOR_ADMIN_URL=https://your-store.saleor.cloud/dashboard/

# Site URL for SEO
# NEXT_PUBLIC_SITE_URL=https://yourstore.com

# Auth token for authenticated requests (optional)
SALEOR_AUTH_TOKEN=

# App secret for webhook verification (optional)
SALEOR_APP_SECRET=

# --- Server-side payments (Route Handlers under src/app/api) ---

# Saleor App token with HANDLE_PAYMENTS + MANAGE_CHECKOUTS. Create the app in the
# Saleor dashboard (Apps -> create) and paste its token here. Used by the server
# to record transactions and complete checkouts.
SALEOR_APP_TOKEN=
# Local dev fallback if SALEOR_APP_TOKEN is empty: staff login via tokenCreate.
# Defaults to admin@example.com / admin when unset.
SALEOR_EMAIL=
SALEOR_PASSWORD=

# PesaPal (Kenya — M-Pesa + cards). Sandbox base: https://cybqa.pesapal.com/pesapalv3
# Prod base: https://pay.pesapal.com/v3
PESAPAL_CONSUMER_KEY=
PESAPAL_CONSUMER_SECRET=
PESAPAL_API_BASE=https://cybqa.pesapal.com/pesapalv3
# Run GET /api/payments/pesapal/register-ipn (with NEXT_PUBLIC_SITE_URL=https://shop.dennis-muraguri.co.ke) to get this value.
PESAPAL_IPN_ID=

# PayPal (international). Sandbox base: https://api-m.sandbox.paypal.com
# Prod base: https://api-m.paypal.com
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_API_BASE=https://api-m.sandbox.paypal.com
# Webhook ID from PayPal Developer Dashboard → Webhooks (required in production).
# Register URL: https://shop.dennis-muraguri.co.ke/api/payments/paypal/webhook
PAYPAL_WEBHOOK_ID=

# Cron endpoint auth — must match CRON_SECRET Vercel env var. Generate: openssl rand -hex 32
CRON_SECRET=

# FX rate override: USD→KES fixed rate. Takes precedence over the daily-cached live rate.
# Use in staging/dev or as an emergency fallback if the live feed is unreachable.
# Example: USD_KES_RATE=130.00
USD_KES_RATE=
